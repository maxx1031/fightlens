# Server-only credentials. Run pnpm live:setup to create fresh local values.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FIGHTLENS_WORKER_SECRET=
FIGHTLENS_ROOM_PREFIX=
FIGHTLENS_CONTROL_URL=http://127.0.0.1:4173
FIGHTLENS_YOLO_MODEL=yolo11n-pose.pt
FIGHTLENS_YOLO_DEVICE=auto
FIGHTLENS_YOLO_FPS=15

# For physical phones, configure trusted HTTPS/WSS and reachable media paths.
# FIGHTLENS_PUBLIC_URL=https://fightlens.example.com
# LIVEKIT_PUBLIC_URL=wss://rtc.example.com

# VAST Builders Challenge Cosmos3 Reason configuration.
#
# On the workshop VM these values are already available in /config/<team>.config.
# Do not copy GPU_BEARER_TOKEN into Git or share it in logs.

# Optional: defaults to the VAST workshop endpoint http://166.19.38.112:8001.
COSMOS3_REASON_URL=
COSMOS3_REASON_MODEL=
GPU_BEARER_TOKEN=

# Optional aliases supported by the script:
# COSMOS_API_BASE=
# COSMOS_MODEL=
# COSMOS_API_KEY=

COSMOS_TIMEOUT_S=600

# OpenRouter Decisions. Keep the real key only in an untracked .env or shell.
OPENROUTER_API_KEY=
